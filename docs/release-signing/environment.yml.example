# INACTIVE explanatory fragment, not a deployable workflow or GitHub settings.
# release-signing ID 24870421379 was created/read back 2026-10-21 with
# custom_branch_policies:true, protected_branches:false and sole {type:tag,name:"v*"}.
# Do not recreate it or add a per-version rule; preserve/re-inspect its policy.
# All four platform signing builds bind/check this environment; hosted tagged
# execution through this route remains unobserved. Existing identities were
# migrated on 2026-10-21: all4 environment names present, all4 repository
# fallbacks absent (three retired, optional updater password already absent).
# Known writes, public identity checks and scoped metadata establish configuration;
# name metadata alone does not prove stored bytes or a hosted signing run.
# No reviewer, timer, service or PAT is selected by this source. Preserve any
# stronger protections deliberately configured by a maintainer.
# Preserve the existing identities/protected backups and verified scope.
# See ../RELEASE-TRUST.md for the acceptance threshold and remaining observations.
# Actual release.yml additionally performs public API preflight in validate,
# then rechecks inside build before mapping any signing values.
jobs:
  build:
    needs: [validate, verify]
    environment: release-signing
    permissions:
      contents: read
      actions: read
      id-token: write
      attestations: write
    # Keep existing exact-tag/SHA verification; v* is not SemVer validation and
    # intentionally preserves existing stable/prerelease behavior.
    # OS/updater inputs stay step-scoped. Do not add them to verify/publish.
