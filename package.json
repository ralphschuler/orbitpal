{
  "name": "orbitpal",
  "private": true,
  "version": "0.8.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "node scripts/verify-avatar-decoders.mjs && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest",
    "test:run": "vitest run",
    "test:avatar-decoders": "node scripts/prepare-avatar-wasm.mjs && node --test scripts/avatar-wasm-memory-tests.mjs scripts/avatar-draco-budget-tests.mjs && node scripts/prepare-avatar-draco.mjs && node scripts/prepare-avatar-decoders.mjs && node scripts/avatar-decoder-browser-tests.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@lucide/svelte": "^1.59.0",
    "@pixiv/three-vrm": "^3.0.0",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-opener": "^2.0.0",
    "svelte": "^5.0.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "svelte-check": "^4.7.7",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "description": "A customizable desktop AI cohost for Twitch and YouTube",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ralphschuler/orbitpal.git"
  },
  "homepage": "https://github.com/ralphschuler/orbitpal",
  "bugs": {
    "url": "https://github.com/ralphschuler/orbitpal/issues"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.12.0"
  }
}
