{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OrbitPal Native World Fixture",
  "version": "0.0.0",
  "identifier": "studio.orbitpal.native-world-fixture",
  "build": {
    "frontendDist": "../dist",
    "devUrl": null,
    "beforeDevCommand": null,
    "beforeBuildCommand": null,
    "beforeBundleCommand": null
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OrbitPal Native World Fixture",
        "width": 1440,
        "height": 960,
        "minWidth": 960,
        "minHeight": 700,
        "visible": false,
        "incognito": true,
        "backgroundThrottling": "disabled",
        "backgroundColor": "#141923"
      }
    ],
    "security": {
      "capabilities": [
        {
          "identifier": "native-world-fixture",
          "windows": [
            "main",
            "avatar-*"
          ],
          "permissions": [
            "core:default",
            "core:window:allow-close",
            "core:window:allow-hide",
            "core:window:allow-show"
          ]
        }
      ],
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src blob:; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob: http://127.0.0.1:*; media-src 'self' blob: data: http://127.0.0.1:*; connect-src 'self' blob: data: ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:*; font-src 'self' data:",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": null
}
