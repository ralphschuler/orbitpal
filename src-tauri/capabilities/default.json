{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop",
  "description": "Desktop controls for the studio and character overlay",
  "windows": ["main", "avatar", "avatar-*"],
  "permissions": ["core:default", "core:window:allow-start-dragging", "core:window:allow-set-always-on-top", "core:window:allow-set-ignore-cursor-events", "core:window:allow-close", "core:window:allow-hide", "core:window:allow-show", "dialog:allow-open", "dialog:allow-save", "opener:allow-open-url", "opener:allow-open-path", "opener:allow-reveal-item-in-dir"]
}
