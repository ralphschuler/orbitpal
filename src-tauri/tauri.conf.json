{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Streamer AI Cohost",
  "version": "0.5.0",
  "identifier": "studio.streamer-ai.cohost",
  "build": {
    "beforeDevCommand": "pnpm dev", "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build", "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Streamer AI Cohost", "width": 1440, "height": 960, "minWidth": 960, "minHeight": 700, "backgroundColor": "#141923", "titleBarStyle": "Overlay", "hiddenTitle": true, "trafficLightPosition": { "x": 18, "y": 22 } }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob: http://127.0.0.1:*; media-src 'self' blob: data: http://127.0.0.1:*; connect-src 'self' blob: ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:*; font-src 'self' data:",
      "assetProtocol": { "enable": true, "scope": [] }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "Dein eigener KI-Cohost für Twitch und YouTube",
    "category": "Entertainment",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "minimumSystemVersion": "12.0", "infoPlist": "Info.plist" }
  }
}
