{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OrbitPal",
  "version": "0.8.0",
  "identifier": "studio.streamer-ai.cohost",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OrbitPal",
        "width": 1440,
        "height": 960,
        "minWidth": 960,
        "minHeight": 700,
        "backgroundColor": "#141923",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 22
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob: http://127.0.0.1:*; media-src 'self' blob: data: http://127.0.0.1:*; connect-src 'self' blob: ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:*; font-src 'self' data:",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "Your customizable AI streaming companion",
    "category": "Entertainment",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "infoPlist": "Info.plist",
      "entitlements": "Entitlements.plist"
    },
    "createUpdaterArtifacts": true,
    "windows": {
      "wix": {
        "upgradeCode": "A9976BDA-0F16-5FD9-A9C4-BDD0372B8376",
        "fragmentPaths": [
          "windows/legacy-msi-shortcuts.wxs"
        ],
        "componentGroupRefs": [
          "OrbitPalLegacyMsiShortcuts"
        ]
      },
      "nsis": {
        "template": "windows/installer.nsi",
        "installerHooks": "windows/branding-hooks.nsh"
      }
    },
    "linux": {
      "deb": {
        "provides": [
          "streamer-ai-cohost"
        ],
        "conflicts": [
          "streamer-ai-cohost"
        ],
        "replaces": [
          "streamer-ai-cohost"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMxNDJGQzFGNjUwRkJCQzkKUldUSnV3OWxIL3hDTVhUNnhjU1N2V2t2RTl1ajlETkNiSnIzYmgwRVZKL0RUVmJwdGY1c2NHaXQK",
      "endpoints": [
        "https://github.com/ralphschuler/orbitpal/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      },
      "requireSignedVersion": true
    }
  }
}
